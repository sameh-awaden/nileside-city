; Engine configuration file.
; Nileside City Native Vertical Slice v0.1
config_version=5

[application]
config/name="Nileside City"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[autoload]
GameState="*res://scripts/game_state.gd"

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=2
anti_aliasing/quality/msaa_2d=1

[gui]
theme/default_font_multichannel_signed_distance_field=true

[input_devices]
pointing/emulate_touch_from_mouse=true

[physics]
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[debug]

gdscript/warnings/treat_warnings_as_errors=false
